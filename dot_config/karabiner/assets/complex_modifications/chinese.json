{
    "description": "When pressing the right option/alt key alone, switch to Simplified Chinese",
    "manipulators": [
        {
            "from": {
                "key_code": "right_alt",
                "modifiers": { "optional": ["any"] }
            },
            "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
            "to": [
                {
                    "key_code": "left_alt",
                    "lazy": true
                }
            ],
            "to_if_alone": [{ "select_input_source": { "language": "zh-Hans" } }],
            "to_if_held_down": [{ "key_code": "left_alt" }],
            "type": "basic"
        }
    ]
}
